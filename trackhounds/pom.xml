<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>3.5.16</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>
	<groupId>com.trackhounds</groupId>
	<artifactId>trackhounds</artifactId>
	<version>3.0.0</version>
	<name>trackhounds</name>
	<description>TrackHounds - offline desktop scoring application for Master's Foxhunts</description>

	<properties>
		<java.version>24</java.version>
		<sqlite-jdbc.version>3.53.4.0</sqlite-jdbc.version>
		<!-- JavaFX WebView application window (iteration 9). The javafx-* POMs pick the platform classifier. -->
		<javafx.version>26.0.2</javafx.version>

		<!-- Frontend build (React/Vite). The build downloads its own Node so only a JDK is required. -->
		<frontend.directory>${project.basedir}/../frontend</frontend.directory>
		<node.version>v22.23.2</node.version>
		<!-- Outside target/ so "mvn clean" neither re-downloads Node nor trips over a locked node.exe. -->
		<node.installDirectory>${project.basedir}/.node</node.installDirectory>
		<skipFrontend>false</skipFrontend>

		<!-- Desktop packaging (jpackage). -->
		<app.name>TrackHounds</app.name>
		<!--
		  Note: app.version (the numeric version handed to jpackage) is deliberately NOT declared here.
		  Maven interpolates the whole POM, including plugin configuration, before any plugin runs, so a
		  property declared here would be frozen to its literal value and build-helper's regex-property
		  could never override it. Leaving it undeclared keeps ${app.version} unresolved until the
		  numeric-app-version execution below sets it at build time.
		-->
		<app.vendor>Hunt Tynch</app.vendor>
		<app.mainClass>com.trackhounds.trackhounds.TrackhoundsApplication</app.mainClass>
		<!--
		  jpackage starts a class from the jar on the class path, it does not run "java -jar". The Spring Boot
		  executable jar keeps its libraries nested under BOOT-INF/, so the entry point must be Spring Boot's
		  launcher (it reads Start-Class from the manifest), not the application class itself.
		-->
		<app.launcherClass>org.springframework.boot.loader.launch.JarLauncher</app.launcherClass>
		<app.icon>${project.basedir}/src/main/jpackage/trackhounds.ico</app.icon>
		<app.license>${project.basedir}/../LICENSE.txt</app.license>
		<!-- Stable id so a newer installer upgrades an older install instead of installing side by side. -->
		<app.win.upgradeUuid>4f494e68-67d0-4c4a-ba5c-2170267c70ba</app.win.upgradeUuid>
		<jpackage.input>${project.build.directory}/jpackage-input</jpackage.input>
		<jpackage.destination>${project.build.directory}/dist</jpackage.destination>
	</properties>

	<dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-web</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
		</dependency>

		<!-- Embedded database: a single SQLite file, no server process required. -->
		<dependency>
			<groupId>org.xerial</groupId>
			<artifactId>sqlite-jdbc</artifactId>
			<version>${sqlite-jdbc.version}</version>
		</dependency>
		<dependency>
			<groupId>org.hibernate.orm</groupId>
			<artifactId>hibernate-community-dialects</artifactId>
		</dependency>
		<!-- Versioned schema migrations (db/migration). SQLite support is part of flyway-core;
		     DatabaseMigration runs it, Boot's Flyway auto-configuration is switched off. -->
		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-core</artifactId>
		</dependency>
		<!-- JavaFX WebView application window (trackhounds.desktop.window=javafx). Loaded from the
		     class path inside the fat jar; the native libraries are unpacked to the data folder. -->
		<dependency>
			<groupId>org.openjfx</groupId>
			<artifactId>javafx-controls</artifactId>
			<version>${javafx.version}</version>
		</dependency>
		<dependency>
			<groupId>org.openjfx</groupId>
			<artifactId>javafx-web</artifactId>
			<version>${javafx.version}</version>
		</dependency>

		<dependency>
			<groupId>com.google.code.gson</groupId>
			<artifactId>gson</artifactId>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-configuration-processor</artifactId>
			<optional>true</optional>
		</dependency>
		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<optional>true</optional>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<finalName>trackhounds-${project.version}</finalName>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<configuration>
					<annotationProcessorPaths>
						<path>
							<groupId>org.projectlombok</groupId>
							<artifactId>lombok</artifactId>
						</path>
						<path>
							<groupId>org.springframework.boot</groupId>
							<artifactId>spring-boot-configuration-processor</artifactId>
						</path>
					</annotationProcessorPaths>
				</configuration>
			</plugin>

			<!-- Build the React UI and bundle it into the jar as static resources. -->
			<plugin>
				<groupId>com.github.eirslett</groupId>
				<artifactId>frontend-maven-plugin</artifactId>
				<version>2.0.2</version>
				<configuration>
					<workingDirectory>${frontend.directory}</workingDirectory>
					<installDirectory>${node.installDirectory}</installDirectory>
					<skip>${skipFrontend}</skip>
				</configuration>
				<executions>
					<execution>
						<id>install-node-and-npm</id>
						<goals>
							<goal>install-node-and-npm</goal>
						</goals>
						<phase>generate-resources</phase>
						<configuration>
							<nodeVersion>${node.version}</nodeVersion>
						</configuration>
					</execution>
					<execution>
						<id>npm-ci</id>
						<goals>
							<goal>npm</goal>
						</goals>
						<phase>generate-resources</phase>
						<configuration>
							<arguments>ci</arguments>
						</configuration>
					</execution>
					<execution>
						<id>npm-build</id>
						<goals>
							<goal>npm</goal>
						</goals>
						<phase>generate-resources</phase>
						<configuration>
							<arguments>run build</arguments>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-resources-plugin</artifactId>
				<executions>
					<execution>
						<id>copy-frontend-dist</id>
						<phase>process-resources</phase>
						<goals>
							<goal>copy-resources</goal>
						</goals>
						<configuration>
							<skip>${skipFrontend}</skip>
							<outputDirectory>${project.build.outputDirectory}/static</outputDirectory>
							<resources>
								<resource>
									<directory>${frontend.directory}/dist</directory>
								</resource>
							</resources>
						</configuration>
					</execution>
				</executions>
			</plugin>

			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
				<configuration>
					<mainClass>${app.mainClass}</mainClass>
					<excludes>
						<exclude>
							<groupId>org.projectlombok</groupId>
							<artifactId>lombok</artifactId>
						</exclude>
					</excludes>
				</configuration>
				<executions>
					<execution>
						<goals>
							<goal>build-info</goal>
						</goals>
					</execution>
				</executions>
			</plugin>

			<!--
			  Derive the numeric jpackage version from the project version: 3.0.0-rc.1 and 3.0.0-SNAPSHOT
			  both become 3.0.0. Windows rejects anything else. app.version is intentionally not declared as a
			  property, otherwise POM interpolation would freeze it before this execution runs.
			-->
			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>build-helper-maven-plugin</artifactId>
				<version>3.6.1</version>
				<executions>
					<execution>
						<id>numeric-app-version</id>
						<phase>validate</phase>
						<goals>
							<goal>regex-property</goal>
						</goals>
						<configuration>
							<name>app.version</name>
							<value>${project.version}</value>
							<regex>^(\d+(?:\.\d+){0,2}).*$</regex>
							<replacement>$1</replacement>
							<failIfNoMatch>true</failIfNoMatch>
						</configuration>
					</execution>
				</executions>
			</plugin>

			<!--
			  Declared after spring-boot-maven-plugin on purpose: the app-image profile adds a package-phase
			  execution to this plugin, and executions run in plugin declaration order within a phase, so the
			  staged jar is the repackaged (executable) one.
			-->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-antrun-plugin</artifactId>
				<version>3.1.0</version>
				<executions>
					<execution>
						<!-- jpackage marks its launcher read-only, which "mvn clean" cannot delete on Windows. -->
						<id>unlock-app-image</id>
						<phase>pre-clean</phase>
						<goals>
							<goal>run</goal>
						</goals>
						<configuration>
							<target>
								<attrib readonly="false">
									<fileset dir="${jpackage.destination}" erroronmissingdir="false"/>
								</attrib>
							</target>
						</configuration>
					</execution>
				</executions>
			</plugin>

			<plugin>
				<groupId>org.jacoco</groupId>
				<artifactId>jacoco-maven-plugin</artifactId>
				<version>0.8.15</version>
				<executions>
					<execution>
						<id>prepare-agent</id>
						<goals>
							<goal>prepare-agent</goal>
						</goals>
					</execution>
					<execution>
						<id>report</id>
						<phase>verify</phase>
						<goals>
							<goal>report</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

	<profiles>
		<!--
		  Desktop packaging with jpackage (bundled in JDK 21+).

		  app-image     : self-contained folder with TrackHounds.exe + private Java runtime. Works on any
		                  machine with a JDK; no extra tools needed. Zip it for a "portable" distribution.
		  win-installer : TrackHounds-<version>.exe installer built from the app image. Needs WiX Toolset 3.x
		                  on the build machine (preinstalled on GitHub's windows-latest runners).

		  Usage:  mvnw -Papp-image package
		          mvnw -Papp-image,win-installer package
		-->
		<profile>
			<id>app-image</id>
			<build>
				<plugins>
					<!-- Stage the executable (repackaged) jar alone in an input folder for jpackage. -->
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-antrun-plugin</artifactId>
						<executions>
							<execution>
								<id>stage-jpackage-input</id>
								<phase>package</phase>
								<goals>
									<goal>run</goal>
								</goals>
								<configuration>
									<target>
										<delete dir="${jpackage.input}" quiet="true"/>
										<mkdir dir="${jpackage.input}"/>
										<copy file="${project.build.directory}/${project.build.finalName}.jar" todir="${jpackage.input}"/>
										<copy file="${project.basedir}/src/main/jpackage/splash.png" todir="${jpackage.input}"/>
									</target>
								</configuration>
							</execution>
						</executions>
					</plugin>
					<plugin>
						<groupId>org.panteleyev</groupId>
						<artifactId>jpackage-maven-plugin</artifactId>
						<version>1.8.0</version>
						<executions>
							<execution>
								<id>app-image</id>
								<phase>package</phase>
								<goals>
									<goal>jpackage</goal>
								</goals>
								<configuration>
									<type>APP_IMAGE</type>
									<name>${app.name}</name>
									<appVersion>${app.version}</appVersion>
									<vendor>${app.vendor}</vendor>
									<description>${project.description}</description>
									<icon>${app.icon}</icon>
									<input>${jpackage.input}</input>
									<mainJar>${project.build.finalName}.jar</mainJar>
									<mainClass>${app.launcherClass}</mainClass>
									<destination>${jpackage.destination}</destination>
									<removeDestination>true</removeDestination>
									<javaOptions>
										<option>-Xms64m</option>
										<option>-Xmx512m</option>
										<option>-XX:+UseSerialGC</option>
										<option>-XX:TieredStopAtLevel=1</option>
										<option>-Dfile.encoding=UTF-8</option>
										<option>-Dtrackhounds.launcher=jpackage</option>
										<!-- Shown by the JVM until the server is ready and the launcher closes it. -->
										<option>-splash:$APPDIR\splash.png</option>
									</javaOptions>
									<!-- Minimal runtime image; everything else is stripped by jlink. -->
									<addModules>
										<module>java.base</module>
										<module>java.desktop</module>
										<module>java.instrument</module>
										<module>java.logging</module>
										<module>java.management</module>
										<module>jdk.management</module>
										<module>java.naming</module>
										<module>java.net.http</module>
										<module>java.prefs</module>
										<module>java.scripting</module>
										<module>java.security.jgss</module>
										<module>java.sql</module>
										<module>java.xml</module>
										<module>jdk.charsets</module>
										<module>jdk.crypto.ec</module>
										<module>jdk.localedata</module>
										<module>jdk.unsupported</module>
										<module>jdk.zipfs</module>
										<!-- Needed by JavaFX (graphics and WebView) when loaded from the class path. -->
										<module>java.datatransfer</module>
										<module>jdk.jsobject</module>
										<module>jdk.xml.dom</module>
									</addModules>
									<jLinkOptions>
										<option>--strip-debug</option>
										<option>--no-header-files</option>
										<option>--no-man-pages</option>
									</jLinkOptions>
								</configuration>
							</execution>
						</executions>
					</plugin>
				</plugins>
			</build>
		</profile>

		<profile>
			<id>win-installer</id>
			<build>
				<plugins>
					<plugin>
						<groupId>org.panteleyev</groupId>
						<artifactId>jpackage-maven-plugin</artifactId>
						<version>1.8.0</version>
						<executions>
							<execution>
								<id>win-installer</id>
								<phase>package</phase>
								<goals>
									<goal>jpackage</goal>
								</goals>
								<configuration>
									<type>EXE</type>
									<name>${app.name}</name>
									<appVersion>${app.version}</appVersion>
									<vendor>${app.vendor}</vendor>
									<description>${project.description}</description>
									<icon>${app.icon}</icon>
									<licenseFile>${app.license}</licenseFile>
									<appImage>${jpackage.destination}/${app.name}</appImage>
									<destination>${jpackage.destination}</destination>
									<aboutUrl>https://github.com/hctynch/trackhounds</aboutUrl>
									<winShortcut>true</winShortcut>
									<winMenu>true</winMenu>
									<winMenuGroup>${app.name}</winMenuGroup>
									<winDirChooser>true</winDirChooser>
									<winPerUserInstall>true</winPerUserInstall>
									<winUpgradeUuid>${app.win.upgradeUuid}</winUpgradeUuid>
								</configuration>
							</execution>
						</executions>
					</plugin>
				</plugins>
			</build>
		</profile>
	</profiles>
</project>
